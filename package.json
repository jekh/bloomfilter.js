{
	"name": "@jekh/bloomfilter",
	"version": "1.1.0",
	"private": true,
	"packageManager": "pnpm@12.3.4",
	"license": "BSD-3-Clause",
	"description": "Fast bloom filter in JavaScript.",
	"keywords": [
		"bloom filter",
		"probabilistic data structure"
	],
	"type": "module",
	"homepage": "https://github.com/jekh/bloomfilter.js",
	"author": {
		"name": "Jason Davies",
		"url": "https://www.jasondavies.com/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jekh/bloomfilter.js.git"
	},
	"bugs": {
		"url": "https://github.com/jekh/bloomfilter.js/issues"
	},
	"main": "bloomfilter.js",
	"types": "bloomfilter.d.ts",
	"exports": {
		".": {
			"types": "./bloomfilter.d.ts",
			"import": "./bloomfilter.js",
			"default": "./bloomfilter.js"
		}
	},
	"files": [
		"bloomfilter.js",
		"bloomfilter.d.ts"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "biome check .",
		"format": "biome check --write .",
		"lint": "biome check --error-on-warnings",
		"lint:fix": "biome check --write",
		"prepack": "npm run build",
		"test": "npm run build && tsc -p tsconfig.test.json && node --test .test/test/bloomfilter-test.js"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^22.20.2",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
